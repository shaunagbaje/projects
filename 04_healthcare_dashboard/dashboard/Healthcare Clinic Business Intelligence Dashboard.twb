      <column caption='Completed Appointments' datatype='integer' name='[Calculation_0208889262661635]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [status] = &quot;Completed&quot; THEN 1&#10;    ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='Cancelled Appointments' datatype='integer' name='[Calculation_0208889262903300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#10;    IF [status] = &quot;Cancelled&quot; THEN 1&#10;    ELSE 0&#10;    END&#10;)' />
      </column>
      <column caption='Pending Appointments' datatype='integer' name='[Calculation_0208889262985221]' role='measure' type='quantitative'>
